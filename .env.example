# Local development only. Never commit real secrets.
DATABASE_URL=postgres://postgres:local_dev_only@127.0.0.1:55442/lockabox
# DexPaprika: empty = keyless tier (15 req/min, 10k credits / 30 days per IP). A free key raises it to 30/min, 100k.
DEXPAPRIKA_API_KEY=
# Server seed rotation secret material is generated into the DB; nothing to set here.
# Public RPCs (hidden gates, holding checks). Replace with a provider URL for anything beyond local testing.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Session cookie signing key (32+ random bytes, base64). Generate with: openssl rand -base64 32
SESSION_SECRET=
# Comma-separated ISO country codes to hide swap for (LAB D6: off by default).
GEO_BLOCK_SWAP=
DB_POOL_MAX=10
